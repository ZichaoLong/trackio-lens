{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:run-ml-experiments:metrics-event:1",
  "title": "Portable ML metric event",
  "description": "One append-only scalar metric event in a project-owned JSONL record.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "timestamp",
    "step",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "context": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "additionalProperties": false
}
